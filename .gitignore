# ── SECRETOS Y CREDENCIALES ───────────────────────────────────────────────────
.streamlit/secrets.toml
*.env
.env.*

# ── EXCEL PRIVADO (metodología propietaria Dylus Lab — NUNCA al repo) ─────────
