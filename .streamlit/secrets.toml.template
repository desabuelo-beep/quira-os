# ── QUIRA Intelligence — Template de Secrets ─────────────────────────────────
# INSTRUCCIONES:
#
#   LOCAL:
#   1. Copia este archivo: cp secrets.toml.template secrets.toml
#   2. Reemplaza todos los valores "REEMPLAZA-CON-*" con valores reales
#   3. NUNCA subas secrets.toml al repositorio (está en .gitignore)
#
#   STREAMLIT CLOUD:
#   1. Ve a: app.streamlit.io → tu app → Settings → Secrets
#   2. Pega el contenido completo de secrets.toml (con valores reales)
#   3. Guarda y reinicia la app
#
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY = "sk-ant-REEMPLAZA-CON-TU-KEY"

# ── Autenticación ─────────────────────────────────────────────────────────────
[auth]
ejecutivo_hash     = "REEMPLAZA-CON-HASH"
tecnico_hash       = "REEMPLAZA-CON-HASH"
operador_hash      = "REEMPLAZA-CON-HASH"
administrador_hash = "REEMPLAZA-CON-HASH"

# ── Base de datos ─────────────────────────────────────────────────────────────
[database]
mode = "sqlite"
# supabase_uri = "postgresql://USUARIO:PASSWORD@HOST:5432/postgres"

# ── Grafo ─────────────────────────────────────────────────────────────────────
# Opción A — Cloud: neo4j+s://XXXX.databases.neo4j.io
# Opción B — Local: bolt://localhost:7687
[neo4j]
uri      = "REEMPLAZA-CON-URI"
user     = "neo4j"
password = "REEMPLAZA-CON-PASSWORD"
