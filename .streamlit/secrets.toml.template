# ── API Anthropic (QUIRA IA — Fase 2+) ────────────────────────────────────────
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY = "sk-ant-REEMPLAZA-CON-TU-KEY"

# ── Contraseña de acceso QUIRA (opcional) ─────────────────────────────────────
# Si no se define aquí, usa la contraseña en config.py ("quira2026")
# PMV_PASSWORD = "tu-contraseña-segura"

# ── Base de datos ─────────────────────────────────────────────────────────────
# Modo "sqlite" → base de datos local (desarrollo, sin configuración extra)
# Modo "supabase" → PostgreSQL en Supabase (producción, Streamlit Cloud)
#
# Para PRODUCCIÓN en Streamlit Cloud: cambiar mode a "supabase" y llenar URI.
# Para DESARROLLO LOCAL: dejar como "sqlite" (sin más cambios).

[database]
mode = "sqlite"
# supabase_uri = "postgresql://postgres:[PASSWORD]@db.XXXXXXXXXX.supabase.co:5432/postgres"

# ── Neo4j — Grafo causal QTMP (ADR-013) ────────────────────────────────────────
# LOCAL (Neo4j Desktop): bolt://localhost:7687 · usuario: neo4j
# Si no se configura → la app usa fallback con datos confirmados (Gold Master v5.5)
# ADR-013: GAP_10PCT→Dom12 · AGUA_POTABLE→Dom10 · EQUIDAD→Dom06

[neo4j]
uri      = "bolt://localhost:7687"
user     = "neo4j"
password = "REEMPLAZA-CON-PASSWORD-NEO4J-DESKTOP"
